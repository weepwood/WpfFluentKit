<Window x:Class="WpfFluentKit.Gallery.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="WpfFluentKit · Gallery" Width="1120" Height="750" MinWidth="850" MinHeight="560"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource KitBackgroundBrush}" Foreground="{DynamicResource KitTextBrush}"
 FontFamily="Segoe UI">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource KitSurfaceBrush}" BorderBrush="{DynamicResource KitBorderBrush}" BorderThickness="0,0,1,0">
   <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="8,15,0,28">
      <Border Background="{DynamicResource KitAccentBrush}" Width="36" Height="36" CornerRadius="9"><TextBlock Text="W" FontWeight="Bold" Foreground="White" FontSize="21" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
      <StackPanel Margin="12,0,0,0"><TextBlock Text="WpfFluentKit" FontWeight="SemiBold" FontSize="17"/><TextBlock Style="{StaticResource KitMutedText}" FontSize="11" Text="DESIGN SYSTEM · 0.1"/></StackPanel>
     </StackPanel>
     <TextBlock Text="SHOWCASE" Style="{StaticResource KitMutedText}" FontSize="11" Margin="12,0,0,11"/>
     <Button Style="{StaticResource KitSidebarButton}" Content="⌂   总览概况" Tag="0" Click="Navigate_Click"/>
     <Button Style="{StaticResource KitSidebarButton}" Content="◫   基础控件" Tag="1" Click="Navigate_Click"/>
     <Button Style="{StaticResource KitSidebarButton}" Content="▦   任务与数据" Tag="2" Click="Navigate_Click"/>
     <Button Style="{StaticResource KitSidebarButton}" Content="⚙   外观设置" Tag="3" Click="Navigate_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="6,0,6,12">
      <Separator Margin="0,8"/>
      <TextBlock Text="WPF UI 4.3 · .NET 8" Style="{StaticResource KitMutedText}" Margin="8,10,0,0" FontSize="12"/>
      <TextBlock Text="可复用 · 独立组件" Style="{StaticResource KitMutedText}" Margin="8,4,0,0" FontSize="12"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource KitBorderBrush}" BorderThickness="0,0,0,1" Padding="27,0">
      <Grid><TextBlock Text="UI COMPONENT GALLERY" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource KitSecondaryTextBrush}" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="☾  切换主题" Click="Theme_Click" Margin="0,0,10,0" Padding="12,6"/>
          <Button Content="主题色" Click="Accent_Click" Padding="12,6"/>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,27,30,30">
      <TextBlock x:Name="PageTitle" Text="组件总览" Style="{StaticResource KitPageTitle}"/>
      <TextBlock x:Name="PageDescription" Text="Windows Fluent 视觉规范、组件状态与交互行为。" Style="{StaticResource KitMutedText}" Margin="0,8,0,22"/>
      <StackPanel x:Name="OverviewPanel">
       <UniformGrid Columns="3" Margin="0,0,0,18">
        <Border Style="{StaticResource KitCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="已封装模块" Style="{StaticResource KitMutedText}"/><TextBlock Text="04" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock Text="Theme / Controls / Layout / Demo" Style="{StaticResource KitMutedText}" FontSize="11"/></StackPanel></Border>
        <Border Style="{StaticResource KitCard}" Margin="4,0,4,0"><StackPanel><TextBlock Text="界面主题" Style="{StaticResource KitMutedText}"/><TextBlock Text="02" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock Text="深色与浅色，可实时切换" Style="{StaticResource KitMutedText}" FontSize="11"/></StackPanel></Border>
        <Border Style="{StaticResource KitCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="目标平台" Style="{StaticResource KitMutedText}"/><TextBlock Text="Win" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock Text="Windows · .NET 8" Style="{StaticResource KitMutedText}" FontSize="11"/></StackPanel></Border>
       </UniformGrid>
       <Border Style="{StaticResource KitCard}"><StackPanel>
        <TextBlock Text="欢迎使用交互式组件展示程序" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="通过左侧导航探索按钮、输入、选择、进度、任务、配色和通知。所有示例均可实际操作。" Style="{StaticResource KitMutedText}" Margin="0,10,0,18"/>
        <Button Content="开始探索控件 →" HorizontalAlignment="Left" Padding="16,8" Click="Explore_Click"/>
       </StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="ControlsPanel" Visibility="Collapsed">
        <Border Style="{StaticResource KitCard}" Margin="0,0,0,16"><StackPanel>
          <TextBlock Text="按钮与操作" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <WrapPanel><ui:Button Content="主要操作" Appearance="Primary" Click="Action_Click" Margin="0,0,10,8"/><ui:Button Content="常规按钮" Click="Action_Click" Margin="0,0,10,8"/><ui:Button Content="禁用状态" IsEnabled="False" Margin="0,0,10,8"/><ui:Button Content="显示消息" Click="Notify_Click" Margin="0,0,10,8"/></WrapPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource KitCard}" Margin="0,0,0,16"><StackPanel>
          <TextBlock Text="表单与选择" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15"/>
          <TextBlock Text="输入内容" Style="{StaticResource KitMutedText}" Margin="0,0,0,6"/>
          <ui:TextBox x:Name="SampleInput" PlaceholderText="搜索或输入名称…" Width="350" HorizontalAlignment="Left" Margin="0,0,0,14"/>
          <TextBlock Text="任务类别" Style="{StaticResource KitMutedText}" Margin="0,0,0,6"/>
          <ComboBox SelectedIndex="0" Width="220" HorizontalAlignment="Left" Margin="0,0,0,15"><ComboBoxItem Content="全部任务"/><ComboBoxItem Content="进行中"/><ComboBoxItem Content="已完成"/></ComboBox>
          <ui:ToggleSwitch x:Name="SampleToggle" Content="启用自动保存" IsChecked="True" Margin="0,0,0,12"/>
          <CheckBox Content="启动后最小化到托盘" IsChecked="True" Margin="0,0,0,10"/>
          <RadioButton GroupName="mode" Content="标准模式" IsChecked="True" Margin="0,0,0,6"/>
          <RadioButton GroupName="mode" Content="高级模式" Margin="0,0,0,6"/>
        </StackPanel></Border>
        <Border Style="{StaticResource KitCard}"><StackPanel>
          <TextBlock Text="数值与进度" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <TextBlock Text="拖动滑块改变进度" Style="{StaticResource KitMutedText}"/>
          <Slider x:Name="DemoSlider" Minimum="0" Maximum="100" Value="54" TickFrequency="1" Width="330" HorizontalAlignment="Left" Margin="0,8,0,12" ValueChanged="DemoSlider_ValueChanged"/>
          <ProgressBar x:Name="DemoProgress" Width="330" Height="7" HorizontalAlignment="Left" Value="54" Maximum="100"/>
        </StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="TasksPanel" Visibility="Collapsed">
       <Border Style="{StaticResource KitCard}" Margin="0,0,0,16"><StackPanel>
        <DockPanel><TextBlock Text="任务调度列表" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Left"/><Button Content="+ 新增任务" HorizontalAlignment="Right" Click="AddTask_Click"/></DockPanel>
        <TextBox x:Name="TaskSearch" Margin="0,16,0,12" TextChanged="TaskSearch_TextChanged" ToolTip="搜索任务名称"/>
        <ListBox x:Name="TaskList" Height="175" DisplayMemberPath="Name" SelectionChanged="TaskList_SelectionChanged"/>
        <WrapPanel Margin="0,14,0,0"><Button Content="开始任务" Click="StartTask_Click" Margin="0,0,10,0"/><Button Content="完成任务" Click="FinishTask_Click" Margin="0,0,10,0"/><Button Content="移除选中" Click="RemoveTask_Click"/></WrapPanel>
       </StackPanel></Border>
       <Border Style="{StaticResource KitCard}"><StackPanel><TextBlock Text="运行状态" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="TaskStatus" Text="选择任务后可以开始、完成或删除。" Style="{StaticResource KitMutedText}" Margin="0,12,0,0"/></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
        <Border Style="{StaticResource KitCard}" Margin="0,0,0,16"><StackPanel>
          <TextBlock Text="主题外观" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <ui:ToggleSwitch x:Name="DarkModeToggle" Content="深色模式" IsChecked="True" Checked="DarkMode_Changed" Unchecked="DarkMode_Changed"/>
          <TextBlock Text="选择强调色" Style="{StaticResource KitMutedText}" Margin="0,18,0,8"/>
          <WrapPanel><Button Background="#6677EE" Content="蓝紫" Click="AccentBlue_Click" Margin="0,0,9,0" Foreground="White"/><Button Background="#12A89D" Content="青绿" Click="AccentGreen_Click" Foreground="White" Margin="0,0,9,0"/><Button Background="#DD714F" Content="珊瑚" Click="AccentOrange_Click" Foreground="White"/></WrapPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource KitCard}"><StackPanel><TextBlock Text="应用设置示例" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/><CheckBox Content="启动时自动检查更新" IsChecked="True" Margin="0,0,0,12"/><CheckBox Content="显示状态通知" IsChecked="True" Margin="0,0,0,12"/><Button Content="恢复默认主题" HorizontalAlignment="Left" Click="Reset_Click"/></StackPanel></Border>
      </StackPanel>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource KitBorderBrush}" Padding="24,12"><TextBlock x:Name="StatusText" Text="●  Gallery 已就绪" Foreground="{DynamicResource KitSecondaryTextBrush}" FontSize="12"/></Border>
  </Grid>
 </Grid>
</Window>